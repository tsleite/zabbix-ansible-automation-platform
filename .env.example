# ---------------------------------------------------------------------------
# aap2zabbix collector configuration
# Copy to .env (or export in the cron environment) and fill in the values.
# NEVER commit the real .env file — it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# --- Zabbix -----------------------------------------------------------------
# Zabbix frontend JSON-RPC endpoint
ZABBIX_API_URL=https://zabbix.example.com/api_jsonrpc.php

# API token created in: Administration > API tokens (least-privilege user)
ZABBIX_API_TOKEN=changeme

# Zabbix server (or proxy) address and trapper port used by zabbix_sender
ZABBIX_SERVER=192.0.2.10
ZABBIX_PORT=10051

# Host name EXACTLY as configured in Zabbix (the host linked to the template)
ZABBIX_TARGET_HOST=aap-controller

# Item IDs of jobs.status and jobs.details on the target host.
# Their history is cleared on every run so Latest data shows one snapshot.
# Leave empty to disable history clearing.
ZABBIX_CLEAR_ITEM_IDS=12345,12346

# --- Red Hat Ansible Automation Platform ------------------------------------
# Automation Controller API base URL
AAP_API_URL=https://aap.example.com/api/v2

# Read-only service account is enough (job read permission)
AAP_USERNAME=svc-monitoring
AAP_PASSWORD=changeme

# --- Misc -------------------------------------------------------------------
# Set to "false" ONLY in lab environments with self-signed certificates
VERIFY_TLS=true

# Path to the zabbix_sender binary
ZBX_SENDER=/usr/bin/zabbix_sender

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
